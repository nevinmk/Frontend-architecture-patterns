{
  "name": "07-graphql",
  "private": true,
  "version": "1.0.0",
  "description": "GraphQL data layer: graphql-yoga API + Vite/React/Apollo Client",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/free-ports.mjs 3007 3071",
    "dev": "concurrently --kill-others -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "ports:free": "node ../scripts/free-ports.mjs 3007 3071",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
