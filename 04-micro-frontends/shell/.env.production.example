# Copy to .env.production and fill in, then run `npm run build`.
# The shell fetches this manifest at boot (see Runbook §2B), so remote releases
# and rollbacks never need a rebuild. One manifest per environment.
# Unset, it defaults to the shell's own /remotes.json (public/remotes.json).
VITE_REMOTES_MANIFEST_URL=https://cdn.example.com/prod/remotes.json

# Runtime (NOT VITE_*): read by shell/server.mjs when it composes the reviews
# SSR fragment into each page. The remote's own REVIEWS_PUBLIC_URL must be the
# origin browsers can reach it on.
# REVIEWS_FRAGMENT_URL=https://reviews.example.com/fragment
# FRAGMENT_TIMEOUT_MS=1500
