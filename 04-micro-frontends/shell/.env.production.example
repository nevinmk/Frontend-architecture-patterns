# Copy to .env.production and fill in with each team's real deployed URL,
# then run `npm run build` — Vite inlines these at build time.
VITE_PRODUCTS_REMOTE_URL=https://products.example.com/remoteEntry.js
VITE_CART_REMOTE_URL=https://cart.example.com/remoteEntry.js

# Runtime (NOT VITE_*): read by shell/server.mjs when it composes the reviews
# SSR fragment into each page. The remote's own REVIEWS_PUBLIC_URL must be the
# origin browsers can reach it on.
# REVIEWS_FRAGMENT_URL=https://reviews.example.com/fragment
# FRAGMENT_TIMEOUT_MS=1500
